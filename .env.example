# Free open-weight chat model via Groq's OpenAI-compatible API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

CHROMA_DB_DIR=data/processed/chroma_db
RAW_DATA_DIR=data/raw

# Shared secret required on the X-API-Key header for POST /api/chat.
# Set the same value here and wherever the frontend/Salesforce calls the API.
# Leave unset only for local dev if you want the check disabled.
OLLIE_API_KEY=change-me-to-a-random-secret
